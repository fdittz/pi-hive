{
  "name": "@fdittz/pi-hive",
  "version": "0.1.0",
  "description": "Coordinated subagent orchestration for pi with live transcripts, handoffs, continuable runs, model selection, and custom headers.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagents",
    "agent-orchestration",
    "pi-hive"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "files": [
    "*.ts",
    "agents/",
    "prompts/",
    "docs/",
    "README.md",
    "EXTENSION.md"
  ],
  "scripts": {
    "check:load": "pi --no-extensions -e ./index.ts --list-models",
    "check:no-private-imports": "! grep -R 'pi-coding-agent/dist' . --include='*.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/fdittz/pi-hive.git"
  }
}
